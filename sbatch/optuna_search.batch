#!/bin/bash

#SBATCH --job-name=parlezeneise_optuna
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --partition=your_partition
#SBATCH --gres=gpu
#SBATCH --constraint=your_gpu
#SBATCH --output=%j_optuna.out
#SBATCH --error=%j_optuna.err

# Load Environment (Adjust paths as needed)
CONDA_ENV_PATH=${CONDA_ENV_PATH:-/data/users/env}
source activate $CONDA_ENV_PATH

# Run Optuna Study
python scripts/training/optuna_tuner.py     --trials 20     --study_name "whisper_zeneise_v1"     --db_url "sqlite:///optuna_zeneise.db"
