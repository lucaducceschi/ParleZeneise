#!/bin/bash

#SBATCH --job-name=parlezeneise_optuna
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --partition=gpu-pre
#SBATCH --gres=gpu:1
#SBATCH --constraint=gpu40g
#SBATCH --account=eurac-commul
#SBATCH --output=%j_optuna.out
#SBATCH --error=%j_optuna.err

# Load Environment (Adjust paths as needed)
source ~/.bashrc
module load anaconda3/2024.6-1
CONDA_ENV_PATH=${CONDA_ENV_PATH:-/data/users/USER_ID/augusta-live/env}
source activate $CONDA_ENV_PATH

# Run Optuna Study
python scripts/training/optuna_tuner.py     --trials 20     --study_name "whisper_zeneise_v1"     --db_url "sqlite:///optuna_zeneise.db"
