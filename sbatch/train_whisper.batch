#!/bin/bash

#SBATCH --job-name=parlezeneise_train
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --partition=your_partition
#SBATCH --gres=gpu
#SBATCH --constraint=gpu
#SBATCH --output=%j_train.out
#SBATCH --error=%j_train.err

# Load Environment (Adjust paths as needed)
CONDA_ENV_PATH=${CONDA_ENV_PATH:-/data/users/env}
source activate $CONDA_ENV_PATH

# Run Training
python scripts/training/trainer.py     --model_id "openai/whisper-large-v3"     --dataset_type "custom"     --data_path "data/train.csv"     --output_dir "./models/v1.0"     --batch_size 8     --gradient_accumulation_steps 2     --learning_rate 3e-5     --dropout 0.15
